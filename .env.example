# Lightning backend: "mock" (default, no node needed) or "lnd"
LN_BACKEND=mock
PORT=3000
# Escrow limits
MIN_SATS=1000
MAX_SATS=500000
# Set only when LN_BACKEND=lnd (use regtest/signet while developing!)
LND_REST_URL=https://localhost:8080
# Baked macaroon with invoices + offchain permissions only (see README). Never the admin macaroon.
LND_MACAROON_HEX=
# Path to the node's tls.cert (pins LND's self-signed certificate)
LND_TLS_CERT_PATH=
# Persist escrows to this file (optional)
DATA_FILE=data/escrows.json
